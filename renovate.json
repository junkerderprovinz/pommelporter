{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>junkerderprovinz/junkerderprovinz//renovate/base"
  ],
  "constraints": {
    "node": "24",
    "npm": "<12"
  },
  "packageRules": [
    {
      "description": "The constraints above set the Node and npm that Renovate itself runs for lockfile updates, so they move by hand",
      "matchManagers": [
        "renovate-config"
      ],
      "matchDepNames": [
        "node",
        "npm"
      ],
      "enabled": false
    }
  ]
}
